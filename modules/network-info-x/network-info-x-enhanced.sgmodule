#!name=网络信息 X · 出口 IP 增强
#!desc=与原网络信息 X 模块同时启用；增加独立出口 IP 面板。
#!author=Surge- custom extension

[Script]
网络信息X-出口IP = type=generic,script-path=https://raw.githubusercontent.com/DlamondEyes/Surge-/main/modules/network-info-x/proxy-exit-copy.js,timeout=15

[Panel]
代理出口 IP = script-name=网络信息X-出口IP,update-interval=300
